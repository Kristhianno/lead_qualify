    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Filtrar Cidade e Situacao Ativa').item.json;\nconst api = $json;\n\nreturn { json: {\n  ...original,\n  razao_social: api.razao_social || api.nome_fantasia || '',\n  cnae_descricao: api.cnae_fiscal_descricao || '',\n  porte: api.porte || '',\n  situacao_cadastral: api.descricao_situacao_cadastral || '',\n  capital_social: Number(api.capital_social) || 0,\n  socios: Array.isArray(api.qsa) ? api.qsa.map(s => s.nome_socio).filter(Boolean).join('; ') : (original.socios || ''),\n  fonte_enriquecimento: 'BrasilAPI'\n} };"
      },
