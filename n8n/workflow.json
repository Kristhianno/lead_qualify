    {
      "parameters": {
        "jsCode": "const MAX_RESULTADOS = 30;\nconst normalizar = s => (s || '').toString().trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst alvo = normalizar(items[0]?.json.cidade);\nconst filtrados = items.filter(i => {\n  const municipio = normalizar(i.json.municipio);\n  const situacao = (i.json.descricao_situacao_cadastral || '').toString().trim().toUpperCase();\n  return municipio === alvo && situacao === 'ATIVA';\n});\nreturn filtrados.slice(0, MAX_RESULTADOS);"
      },
