        "jsCode": "const search = $('Normalizar Busca').first().json;\nconst companies = [];\nfor (const response of items) {\n  const data = Array.isArray(response.json.data) ? response.json.data : [];\n  for (const company of data) {\n    companies.push({ json: { ...company, segmento: search.segmento, uf: search.estado, cidade: search.cidade, telefone_sdr: search.telefone_sdr } });\n  }\n}\nreturn companies;"
      },
