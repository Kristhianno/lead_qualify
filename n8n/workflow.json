    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Filtrar Cidade e Situacao Ativa').item.json;\nconst api = $json;\nconst capitalSocialNum = Number((api.capital_social || '0').toString().replace(/\\./g, '').replace(',', '.')) || 0;\n\nreturn { json: {\n  ...original,\n  razao_social: api.razao_social || api.nome_fantasia || '',\n  cnae_descricao: api.cnae_principal || '',\n  porte: api.porte_empresa || '',\n  situacao_cadastral: api.situacao_cadastral || '',\n  capital_social: capitalSocialNum,\n  socios: original.socios || '',\n  fonte_enriquecimento: 'OpenCNPJ'\n} };"
      },
      "id": "a8d47298-1d61-4400-a08d-5b51d93d48b8",
      "name": "Formatar Dados OpenCNPJ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2416,
        1024
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\n// --- Constantes ajustáveis — recalibrar depois de ver dados reais do segmento buscado ---\nconst CAPITAL_SOCIAL_QUENTE = 100000;\nconst CAPITAL_SOCIAL_ATENCAO = 20000;\n\nfunction normalizarPorte(raw) {\n  const v = (raw ?? '').toString().trim().toUpperCase();\n  if (['01', '1', 'MICRO EMPRESA', 'ME'].includes(v)) return 'ME';\n  if (['03', '3', 'EMPRESA DE PEQUENO PORTE', 'EPP'].includes(v)) return 'EPP';\n  if (['05', '5', 'DEMAIS', 'DEMAIS EMPRESAS'].includes(v)) return 'DEMAIS';\n  return 'DESCONHECIDO';\n}\n\nconst porte = normalizarPorte(item.porte);\nconst capitalSocial = Number(item.capital_social) || 0;\n\nlet tier = 'desqualificado';\nif (porte === 'DEMAIS' && capitalSocial >= CAPITAL_SOCIAL_QUENTE) tier = 'quente';\nelse if (porte === 'DEMAIS' || (porte === 'EPP' && capitalSocial >= CAPITAL_SOCIAL_ATENCAO)) tier = 'atencao';\n\n// Valores INTERNOS da propriedade lifecyclestage (Lifecycle Stage), que é a\n// propriedade usada pelo Board de Contatos nesta conta do HubSpot — NÃO é\n// hs_lead_status (confirmado via GET /crm/v3/properties/contacts/lifecyclestage).\n// 'lead' e 'opportunity' são valores padrão do HubSpot; '1398914058' é o valor\n// interno auto-gerado quando a opção customizada \"Nutrir\" foi criada nesta\n// conta — não é literalmente a string 'nutrir'. Se recriar a opção em outra\n// conta, confira o valor de novo em Configurações > Propriedades > Lifecycle Stage.\nconst HUBSPOT_LIFECYCLE_STAGE = {\n  quente: 'lead',\n  atencao: 'opportunity',\n  desqualificado: '1398914058'\n};\n\nreturn { json: {\n  ...item,\n  porte,\n  tier,\n  lifecyclestage: HUBSPOT_LIFECYCLE_STAGE[tier],\n  timestamp: new Date().toISOString()\n} };"
      },
      "id": "9f0aab5e-fc14-4f91-b3e2-fc8b02ea6910",
      "name": "Calcula e Classifica tier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        832
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst systemPrompt = 'Você é um SDR da ALPHADATA, uma plataforma de inteligência de mercado B2B. Dado os dados de uma empresa encontrada numa busca de prospecção por segmento/estado/cidade, responda SOMENTE em JSON válido com duas chaves: resumo_ia (resumo de 1 a 2 frases sobre a empresa e a oportunidade) e abordagem_sugerida (1 frase com o melhor ângulo de abordagem comercial). Não inclua nenhum texto fora do JSON.';\n\nconst userPrompt = [\n  `Empresa: ${item.razao_social}`,\n  `CNAE: ${item.cnae_descricao}`,\n  `Situação cadastral: ${item.situacao_cadastral}`,\n  `Porte: ${item.porte}`,\n  `Capital social: R$ ${item.capital_social}`,\n  `Localização: ${item.municipio}/${item.uf}`,\n  `Tier calculado: ${item.tier}`\n].join('\\n');\n\nreturn { json: {\n  ...item,\n  openai_request_body: JSON.stringify({\n    model: 'gpt-4o-mini',\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: systemPrompt },\n      { role: 'user', content: userPrompt }\n    ]\n  })\n} };"
      },
      "id": "f1a2b3c4-0001-4000-8000-000000000003",
      "name": "Montar Prompt IA",
