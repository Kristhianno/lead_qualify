    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Montar Prompt IA').item.json;\nlet resumo_ia = '';\nlet abordagem_sugerida = '';\n\ntry {\n  const content = $json?.choices?.[0]?.message?.content || '{}';\n  const result = JSON.parse(content);\n  resumo_ia = result.resumo_ia || '';\n  abordagem_sugerida = result.abordagem_sugerida || '';\n} catch (e) {\n  // mantém strings vazias se a IA falhar ou responder fora do formato esperado\n}\n\nconst { openai_request_body, ...rest } = original;\n\nreturn { json: {\n  ...rest,\n  resumo_ia,\n  abordagem_sugerida\n} };"
      },
